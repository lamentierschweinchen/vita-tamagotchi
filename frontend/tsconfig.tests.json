{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".test-dist",
    "noEmitOnError": true
  },
  "include": ["lib/**/*.ts", "types.ts", "tests/**/*.test.ts"],
  "exclude": ["node_modules"]
}
